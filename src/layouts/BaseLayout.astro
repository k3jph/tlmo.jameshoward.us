---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = 'Teaching and Learning Mathematics Online',
  description = 'The companion site for Teaching and Learning Mathematics Online, edited by James P. Howard, II and John F. Beyers.',
  image
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'Teaching and Learning Mathematics Online'
  ? title
  : `${title} · Teaching and Learning Mathematics Online`;
const currentYear = new Date().getFullYear();
const umgcLogo = "https://mvsfservicefabricusva.blob.core.windows.net/medialibrary-d893c12fb7a1499f83a111d7a377e2eb-r/990770e39d06443c9298c6ca5632ec52/e22a094557804e31ac04ef2fac775f60/Medium/%20GRPHC-logo-clear-space-preferred-alternate.jpg?se=2036-04-23T04%3A39%3A56Z&si=202405281602&sig=G2vAPtmmwxa5Ejmya8BfOUG6PNptov0GbK8bRYOzNGo%3D&sr=b&st=1942-04-27T13%3A43%3A17Z&sv=2017-04-17";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173b60" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Teaching and Learning Mathematics Online home">
        <span class="brand-mark" aria-hidden="true"><img src="/favicon.svg" alt="" /></span>
        <span>
          <strong>TLMO</strong>
          <small>Teaching + Learning Mathematics Online</small>
        </span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/editions/">Editions</a>
        <a href="/chapters/">Chapters</a>
        <a href="/contributors/">Contributors</a>
        <a href="/resources/">Resources</a>
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>

    <footer class="site-footer">
      <div class="footer-top">
        <div class="editor-lockup">
          <div class="editor-images" aria-label="Editors">
            <a href="https://jameshoward.us/" aria-label="James P. Howard, II">
              <img src="https://jameshoward.us/assets/img/identity/jh-badge-1x1.svg" alt="" width="68" height="68" loading="lazy" />
            </a>
            <a href="https://www.umgc.edu/faculty-list" aria-label="John F. Beyers at University of Maryland Global Campus">
              <img class="umgc-mark" src={umgcLogo} alt="" width="68" height="68" loading="lazy" />
            </a>
          </div>
          <div class="editor-lockup-text">
            <a class="footer-domain" href="/">tlmo.jameshoward.us</a>
            <p>A website of <a href="https://jameshoward.us/">James P. Howard, II</a> and <a href="https://www.umgc.edu/faculty-list">John F. Beyers</a>.</p>
          </div>
        </div>
        <p class="footer-description">A companion to <cite>Teaching and Learning Mathematics Online</cite>.<br />Two editions. Shared practice.</p>
      </div>

      <div class="footer-bottom">
        <p>Copyright © 2020–{currentYear} James P. Howard, II and John F. Beyers.</p>
        <nav aria-label="Site notices">
          <a href="/about/">About</a>
          <a href="/contact/">Contact &amp; corrections</a>
          <a href="/notices/#privacy">Privacy Notice</a>
          <a href="/notices/#cookies" data-cookie-preferences>Cookie Settings</a>
          <a href="/notices/#terms">Terms of Use</a>
          <a href="/notices/#copyright">Copyright</a>
        </nav>
      </div>
    </footer>

    <CookieConsent />
  </body>
</html>
