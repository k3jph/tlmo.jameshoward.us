---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Teaching and Learning Mathematics Online',
  description = 'The companion site for Teaching and Learning Mathematics Online, edited by James P. Howard, II and John F. Beyers.'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'Teaching and Learning Mathematics Online'
  ? title
  : `${title} · Teaching and Learning Mathematics Online`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173b60" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Teaching and Learning Mathematics Online home">
        <span class="brand-mark" aria-hidden="true"><img src="/favicon.svg" alt="" /></span>
        <span>
          <strong>TLMO</strong>
          <small>Teaching + Learning Mathematics Online</small>
        </span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/editions/">Editions</a>
        <a href="/resources/">Resources</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div>
        <strong>Teaching and Learning Mathematics Online</strong>
        <p>Edited by James P. Howard, II and John F. Beyers.</p>
      </div>
      <div class="footer-links">
        <a href="/editions/first-edition/">2020 edition</a>
        <a href="/editions/second-edition/">2025 edition</a>
        <a href="https://www.routledge.com/Teaching-and-Learning-Mathematics-Online/HowardII-Beyers/p/book/9781032504537">Publisher ↗</a>
      </div>
    </footer>
  </body>
</html>
