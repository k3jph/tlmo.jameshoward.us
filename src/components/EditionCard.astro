---
import type { Edition } from '../data/editions';
const { edition, featured = false } = Astro.props as { edition: Edition; featured?: boolean };
---
<article class:list={['edition-card', featured && 'featured']}>
  <div class="book-frame">
    <img
      src={edition.cover}
      srcset={`${edition.cover640} 640w, ${edition.cover} 1200w`}
      sizes="(max-width: 700px) 58vw, 310px"
      alt={`Cover of Teaching and Learning Mathematics Online, ${edition.label.toLowerCase()}`}
      loading={featured ? 'eager' : 'lazy'}
    />
  </div>
  <div class="edition-copy">
    <p class="eyebrow">{edition.label} · {edition.year}</p>
    <h2>Teaching and Learning<br />Mathematics Online</h2>
    <p>{edition.description}</p>
    <dl class="mini-specs">
      <div><dt>Chapters</dt><dd>{edition.chapters}</dd></div>
      <div><dt>Pages</dt><dd>{edition.pages}</dd></div>
      <div><dt>Print ISBN</dt><dd>{edition.printIsbn}</dd></div>
    </dl>
    <a class="text-link" href={`/editions/${edition.slug}/`}><span class="text-link-label">Explore the {edition.label.toLowerCase()}</span><span class="text-link-arrow" aria-hidden="true">→</span></a>
  </div>
</article>
