---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Teaching Resources" description="Teaching resources and background material associated with Teaching and Learning Mathematics Online.">
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Teaching resources</p>
      <h1>The website should be useful, too.</h1>
      <p>A book about practical online teaching ought to have a practical online companion. This section is designed to grow with materials that can be used, adapted, or argued with.</p>
    </div>
  </header>
  <section class="section">
    <div class="container">
      <div class="resource-grid">
        <article class="resource-card">
          <div class="symbol">Σ</div>
          <h3>Second-edition call for proposals</h3>
          <p>The questions and scope used to build the expanded 2025 edition.</p>
          <a class="text-link" href="https://jameshoward.us/books/teaching-learning-mathematics-online/">Background material →</a>
        </article>
        <article class="resource-card">
          <div class="symbol">∫</div>
          <h3>First-edition call for proposals</h3>
          <p>A snapshot of the problems we thought mattered before the first edition was assembled.</p>
          <a class="text-link" href="https://jameshoward.us/books/teaching-learning-mathematics-online/">Background material →</a>
        </article>
        <article class="resource-card">
          <div class="symbol">Δ</div>
          <h3>Edition map</h3>
          <p>See which chapters carried forward and where nine new contributions expanded the second edition.</p>
          <a class="text-link" href="/editions/">Compare editions →</a>
        </article>
      </div>
      <div class="callout"><p><strong>Coming next:</strong> chapter-specific links, contributor resources, errata, and useful teaching material can live here without turning the site into a dumping ground.</p></div>
    </div>
  </section>
</BaseLayout>
