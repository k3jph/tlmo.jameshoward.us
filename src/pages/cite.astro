---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Cite the Books" description="Citation information for both editions of Teaching and Learning Mathematics Online.">
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Citation</p>
      <h1>Please cite the edition you actually used.</h1>
      <p>The two editions are substantially different. These records keep the year, edition, DOI, and ISBNs straight.</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="citation-grid">
        <article class="citation-card">
          <p class="eyebrow">Second edition · 2025</p>
          <h2>APA-style</h2>
          <p class="citation-text">Howard, J. P., II, &amp; Beyers, J. F. (Eds.). (2025). <em>Teaching and learning mathematics online</em> (2nd ed.). CRC Press. https://doi.org/10.1201/9781003398547</p>
          <dl class="citation-specs">
            <div><dt>Paperback</dt><dd>9781032504537</dd></div>
            <div><dt>eBook</dt><dd>9781003398547</dd></div>
            <div><dt>DOI</dt><dd>10.1201/9781003398547</dd></div>
          </dl>
        </article>

        <article class="citation-card">
          <p class="eyebrow">First edition · 2020</p>
          <h2>APA-style</h2>
          <p class="citation-text">Howard, J. P., II, &amp; Beyers, J. F. (Eds.). (2020). <em>Teaching and learning mathematics online</em>. CRC Press. https://doi.org/10.1201/9781351245586</p>
          <dl class="citation-specs">
            <div><dt>Paperback</dt><dd>9780815372363</dd></div>
            <div><dt>eBook</dt><dd>9781351245562</dd></div>
            <div><dt>DOI</dt><dd>10.1201/9781351245586</dd></div>
          </dl>
        </article>
      </div>
      <div class="callout"><p>For a chapter citation, begin with the chapter author or authors and use the edition-specific book record above as the container work.</p></div>
    </div>
  </section>
</BaseLayout>
